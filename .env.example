# Athes Sentinel backend environment reference.
# The application reads process environment variables; it does not load this
# file automatically. Use placeholder values only and keep the real .env ignored.

# SQLite for local development; a Postgres URL in production.
DATABASE_URL=sqlite:///./athes_sentinel.db
ATHES_ENV=development
ATHES_SECRET_KEY=replace-with-a-long-random-secret
ATHES_ALLOWED_ORIGINS=http://localhost:5173

# Production login (required when ATHES_ENV=production; min 8 characters).
# Without these no account exists in production.
ATHES_ADMIN_USERNAME=
ATHES_ADMIN_PASSWORD=
# Optional second, read-oriented account.
ATHES_ANALYST_USERNAME=
ATHES_ANALYST_PASSWORD=

# Development seeds admin/admin123 and analyst/analyst123 automatically.
# Leave unset in production; set to "true" only for a throwaway public demo.
# ATHES_SEED_DEMO_USERS=false

# Optional: also allow Vercel preview URLs to call the API.
# ATHES_ALLOWED_ORIGIN_REGEX=https://athes-sentinel-.*\.vercel\.app
